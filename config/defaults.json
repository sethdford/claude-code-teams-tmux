{
  "$schema": "https://shipwright.dev/schemas/defaults-v1.json",
  "description": "Default values for all Shipwright tunables. Override via daemon-config.json, config/policy.json, or SHIPWRIGHT_* env vars.",
  "version": "1",
  "network": {
    "connect_timeout": 10,
    "max_time": 60,
    "gh_timeout": 30,
    "retry_count": 3,
    "retry_delay": 2
  },
  "daemon": {
    "poll_interval": 30,
    "max_parallel": 4,
    "watch_label": "shipwright",
    "issue_limit": 100,
    "on_success_remove_label": true,
    "health_check_interval": 60,
    "stale_job_timeout_hours": 2,
    "branch_pattern": "shipwright/issue-{issue}",
    "worktree_dir": ".worktrees"
  },
  "pipeline": {
    "max_iterations": 20,
    "build_test_retries": 3,
    "claude_timeout": 1800,
    "heartbeat_interval": 30,
    "branch_pattern": "shipwright/issue-{issue}",
    "stage_order": [
      "intake",
      "plan",
      "design",
      "build",
      "test",
      "review",
      "compound_quality",
      "pr",
      "merge",
      "deploy",
      "validate",
      "monitor"
    ]
  },
  "loop": {
    "claude_timeout": 1800,
    "sleep_between_iterations": 2,
    "max_restarts": 0,
    "fast_test_interval": 5,
    "convergence_threshold": 3,
    "multi_agent_sleep": 5
  },
  "dashboard": {
    "port": 8767,
    "poll_interval_ms": 2000,
    "ws_heartbeat_ms": 30000
  },
  "webhook": {
    "port": 8765,
    "secret_length": 32,
    "max_payload_bytes": 1048576
  },
  "urls": {
    "linear_api": "https://api.linear.app/graphql",
    "github_api": "https://api.github.com",
    "github_device_code": "https://github.com/login/device/code",
    "github_device_login": "https://github.com/login/device",
    "otel_endpoint": "http://localhost:4318",
    "tpm_repo": "https://github.com/tmux-plugins/tpm",
    "bun_install": "https://bun.sh/install"
  },
  "intelligence": {
    "cache_ttl": 3600,
    "complexity_bands": {
      "low": 3,
      "medium": 6,
      "high": 10
    },
    "miss_rate_high": 30,
    "miss_rate_low": 5,
    "anomaly_threshold": 3.0,
    "ab_test_ratio": 0.2,
    "claude_timeout": 60,
    "architecture_timeout": 7200
  },
  "quality": {
    "gate_score_threshold": 70,
    "secret_threshold": 3,
    "min_file_count": 10,
    "score_weight_per_file": 25,
    "pass_rate_threshold": 5.0
  },
  "cleanup": {
    "artifact_age_days": 7,
    "heartbeat_stale_seconds": 300,
    "checkpoint_max_count": 10
  },
  "labels": {
    "watch": "shipwright",
    "ready_to_build": "ready-to-build",
    "hotfix": "hotfix",
    "claimed_prefix": "claimed:",
    "incident": [
      "hotfix",
      "shipwright"
    ],
    "incident_labels": "hotfix,shipwright",
    "harness_gap": [
      "harness-gap",
      "shipwright"
    ],
    "harness_gap_labels": "harness-gap,shipwright"
  },
  "limits": {
    "triage_issues": 100,
    "triage_unlabeled": 50,
    "strategic_closed": 30,
    "dora_days": 30,
    "log_tail_lines": 100,
    "function_scan_limit": 0,
    "dependency_scan_limit": 0
  },
  "stages": {
    "intake": {
      "timeout_seconds": 300,
      "max_iterations": 1,
      "description": "Issue intake and initial triage"
    },
    "plan": {
      "timeout_seconds": 1800,
      "max_iterations": 1,
      "description": "Planning and analysis stage"
    },
    "design": {
      "timeout_seconds": 2400,
      "max_iterations": 1,
      "description": "Design and architecture stage"
    },
    "build": {
      "timeout_seconds": 7200,
      "max_iterations": 20,
      "description": "Build and implementation (supports multi-iteration via loop)"
    },
    "test": {
      "timeout_seconds": 1800,
      "max_iterations": 1,
      "description": "Test execution and validation"
    },
    "review": {
      "timeout_seconds": 900,
      "max_iterations": 1,
      "description": "Code review and quality gates"
    },
    "compound_quality": {
      "timeout_seconds": 3600,
      "max_iterations": 1,
      "description": "Compound quality checks (architecture, security, performance)"
    },
    "pr": {
      "timeout_seconds": 900,
      "max_iterations": 1,
      "description": "Pull request creation and management"
    },
    "merge": {
      "timeout_seconds": 600,
      "max_iterations": 1,
      "description": "Merge to target branch"
    },
    "deploy": {
      "timeout_seconds": 1200,
      "max_iterations": 1,
      "description": "Deployment to environment"
    },
    "validate": {
      "timeout_seconds": 900,
      "max_iterations": 1,
      "description": "Post-deployment validation"
    },
    "monitor": {
      "timeout_seconds": 3600,
      "max_iterations": 1,
      "description": "Health monitoring and rollback readiness"
    }
  },
  "build_loop": {
    "circuit_breaker_threshold": 3,
    "min_progress_lines": 5,
    "auto_extend": true,
    "extension_size": 5,
    "max_extensions": 3,
    "description": "Build loop circuit breaker and auto-extension settings for continuous iteration"
  },
  "adaptive": {
    "complexity_bands": {
      "low": {
        "min_iterations": 5,
        "max_iterations": 10,
        "description": "Low complexity issues: straightforward fixes, simple features"
      },
      "medium": {
        "min_iterations": 10,
        "max_iterations": 20,
        "description": "Medium complexity issues: standard features, moderate refactoring"
      },
      "high": {
        "min_iterations": 15,
        "max_iterations": 30,
        "description": "High complexity issues: major features, architectural changes"
      }
    }
  },
  "template_defaults": {
    "fast": {
      "max_iterations": 2,
      "description": "Fast template: minimal stages, score ≥ 70, skip review"
    },
    "standard": {
      "max_iterations": 5,
      "description": "Standard template: medium complexity, full review gates"
    },
    "full": {
      "max_iterations": 8,
      "description": "Full template: complex changes, extra review cycles"
    },
    "hotfix": {
      "max_iterations": 3,
      "description": "Hotfix template: urgent fixes, minimal stages"
    },
    "enterprise": {
      "max_iterations": 20,
      "description": "Enterprise template: maximum safety, all gates enabled"
    },
    "autonomous": {
      "max_iterations": 10,
      "description": "Autonomous template: daemon-driven, all stages enabled"
    }
  },
  "health": {
    "stale_timeout_seconds": 1800,
    "heartbeat_timeout_seconds": 120,
    "description": "Agent health monitoring thresholds"
  }
}
